root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_size = 4
indent_style = space

[*.html]
indent_size = 2
indent_style = space

[*.css]
indent_size = 2
indent_style = space

[*.js]
indent_size = 4
indent_style = space

[*.json]
indent_size = 2
indent_style = space

[requirements.txt]
charset = utf-16le
